# Copia este archivo a .env (cp .env.example .env). Los valores coinciden con docker-compose.yml.
# Todo esto es SOLO para desarrollo local.

# Postgres
POSTGRES_USER=pixels
POSTGRES_PASSWORD=pixels
POSTGRES_DB=pixels
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pixels:pixels@localhost:5432/pixels

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# LiveKit (claves del modo --dev). Nunca exponerlas en el cliente.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# API (Fastify)
API_PORT=3001
CORS_ORIGIN=http://localhost:5173

# Servidor de juego (Colyseus)
GAME_SERVER_PORT=2567

# Frontend (Vite). Solo las variables VITE_* llegan al navegador.
VITE_API_URL=http://localhost:3001
VITE_GAME_SERVER_URL=http://localhost:2567
