# Copia este archivo a deploy/.env y rellénalo. NUNCA lo subas al repositorio.
# Secretos: genera cada uno con  openssl rand -base64 32

# Dominio de la web (sin https://). Necesita registros DNS para DOMINIO, rtc.DOMINIO y turn.DOMINIO
# apuntando a este servidor (en Cloudflare, sin proxy: nube gris).
DOMAIN=pixels.example.com
# Correo para Let's Encrypt (avisos de certificados).
ACME_EMAIL=admin@example.com

# Base de datos
POSTGRES_PASSWORD=

# Secreto compartido entre la API y el servidor de juego (tickets).
TICKET_SECRET=
# Login (Better Auth).
BETTER_AUTH_SECRET=
# Login con Google (opcional). URI de redirección autorizada: https://DOMINIO/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LiveKit: la clave es un nombre cualquiera (p. ej. APIpixels) y el secreto, aleatorio.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Correo de los enlaces de login (SMTP del proveedor). Ejemplos:
#   Postmark: smtps://<token>:<token>@smtp.postmarkapp.com:465
#   Resend:   smtps://resend:<api-key>@smtp.resend.com:465
SMTP_URL=
MAIL_FROM=pixels <no-reply@pixels.example.com>

# Opcional
# BACKUP_KEEP_DAYS=14
# API_RATE_LIMIT=600
