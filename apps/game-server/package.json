{
  "name": "@pixels/game-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bots": "tsx --conditions=source scripts/bots.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.0",
    "@colyseus/schema": "^5.0.0",
    "@colyseus/ws-transport": "^0.18.4",
    "@pixels/db": "workspace:*",
    "@pixels/shared": "workspace:*",
    "@sentry/node": "11.9.0",
    "express": "^5.3.0",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.9",
    "@types/express": "^5.0.6",
    "tsx": "^4.23.15"
  }
}
